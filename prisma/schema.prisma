generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Channel {
  EMAIL
  SMS
  PUSH
}

enum LeadStatus {
  NEW
  ENGAGED
  SOLD
  APPROVED
  FUNDED
  DECLINED
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  UNSUBSCRIBED
}

enum RunStatus {
  DRAFT
  ACTIVE
  PAUSED
}

enum Objective {
  SUBSCRIPTIONS
  SOLD
  APPROVED
  FUNDED
  REVENUE
}

enum EnrollmentStatus {
  ACTIVE
  HELD
  COMPLETED
  STOPPED
}

enum DeliveryStatus {
  PENDING
  SENDING
  SENT
  FAILED
  UNCERTAIN
  CANCELLED
}

model LandingAsset {
  id        String   @id @default(cuid())
  name      String
  alt       String
  kind      String
  sha256    String   @unique
  mimeType  String   @default("image/webp")
  width     Int
  height    Int
  byteSize  Int
  data      Bytes
  createdAt DateTime @default(now())

  @@index([createdAt, id])
}

model LandingAssetUpload {
  id        String    @id @default(cuid())
  tokenHash String
  name      String
  alt       String
  kind      String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([expiresAt])
}

// Sanitized custom page sources are content-addressed and never edited in
// place. Experiments reference their id from Variant.config so historical
// visit snapshots keep rendering the same authored page.
model LandingSource {
  id         String   @id @default(cuid())
  name       String
  htmlBefore String
  htmlAfter  String
  css        String
  sha256     String   @unique
  createdAt  DateTime @default(now())

  @@index([createdAt, id])
}

model Experiment {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  status    RunStatus @default(DRAFT)
  objective Objective @default(SUBSCRIPTIONS)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  offerId   String?
  offer     Offer?    @relation("ExperimentOffer", fields: [offerId], references: [id], onDelete: SetNull)
  variants  Variant[]
  visits    Visit[]
}

model Variant {
  id           String     @id @default(cuid())
  experimentId String
  experiment   Experiment @relation(fields: [experimentId], references: [id])
  name         String
  weight       Int        @default(50)
  config       Json
  archivedAt   DateTime?
  offerId      String?
  offer        Offer?     @relation("VariantOffer", fields: [offerId], references: [id], onDelete: SetNull)
  visits       Visit[]

  @@index([experimentId, archivedAt])
}

model TrafficSource {
  id         String         @id @default(cuid())
  campaignId String
  zoneId     String
  state      String         @default("MONITORING")
  reason     String?
  blockedAt  DateTime?
  visits     Visit[]
  actions    SourceAction[]

  @@unique([campaignId, zoneId])
}

model Visit {
  journeyId             String?
  journey               VisitorJourney?        @relation(fields: [journeyId], references: [id], onDelete: SetNull)
  verificationState     String                 @default("UNVERIFIED")
  verificationAttemptId String?
  verifiedAt            DateTime?
  verificationExpiresAt DateTime?
  verifications         VisitorVerification[]
  retargetingCampaignId String?
  retargetingAudienceId String?
  configSnapshot        Json                   @default("{}")
  id                    String                 @id @default(uuid())
  experimentId          String
  experiment            Experiment             @relation(fields: [experimentId], references: [id])
  variantId             String
  variant               Variant                @relation(fields: [variantId], references: [id])
  sourceId              String?
  source                TrafficSource?         @relation(fields: [sourceId], references: [id])
  externalClickId       String?
  adContext             Json                   @default("{}")
  ipAddress             String                 @default("")
  ipHash                String
  userAgent             String
  country               String?
  region                String?
  city                  String?
  geoSource             String?
  verified              Boolean                @default(false)
  challenged            Boolean                @default(false)
  botScore              Int                    @default(0)
  evidence              String[]
  cost                  Decimal                @default(0) @db.Decimal(12, 6)
  costRecorded          Boolean                @default(false)
  preQuizMeasuredAt     DateTime?
  preQuizEndedAt        DateTime?
  preQuizActiveMs       Int                    @default(0)
  preQuizClicks         Int                    @default(0)
  preQuizScrolls        Int                    @default(0)
  createdAt             DateTime               @default(now())
  leads                 Lead[]
  applications          ApplicationClick[]
  engagementEvents      VisitEvent[]
  landingHits           LandingHit[]
  advertiserConversions AdvertiserConversion[]

  @@index([sourceId, createdAt])
  @@index([ipHash, createdAt])
  @@index([experimentId, createdAt])
  @@index([journeyId, createdAt])
  @@index([createdAt])
}

// A server-observed request to a public landing. This is written before the
// browser application and its JavaScript run, so paid-click delivery loss can
// be separated from render and verification loss.
model LandingHit {
  id              String   @id @default(uuid())
  slug            String
  campaignId      String?
  zoneId          String?
  externalClickId String?
  userAgent       String
  ipAddress       String   @default("")
  ipHash          String
  country         String?
  region          String?
  city            String?
  geoSource       String?
  visitId         String?
  visit           Visit?   @relation(fields: [visitId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())

  @@index([campaignId, zoneId, createdAt])
  @@index([slug, createdAt])
  @@index([visitId])
}

// Cached approximate location avoids sending the same address to the lookup
// provider for every page view. Raw IP addresses stay on the owner-only visit
// and hit records; this cache is keyed by the existing one-way IP hash.
model IpLocationCache {
  ipHash    String   @id
  country   String?
  region    String?
  city      String?
  timezone  String?
  source    String
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

// Complete read-only advertiser report snapshots. Never mixed with click costs.
model AdStatisticsSnapshot {
  id        String   @id
  query     Json
  rows      Json
  fetchedAt DateTime @default(now())
}

// Aggregate dashboard exports only. No recordings, contact fields or raw form data.
model ClaritySnapshot {
  id          String   @id @default(cuid())
  days        Int
  dimensions  String[]
  metrics     Json
  rowCount    Int
  windowStart DateTime
  windowEnd   DateTime
  fetchedAt   DateTime @default(now())

  @@index([fetchedAt])
}

// Browser journeys are deliberately not fingerprints or cross-device identities.
model VisitorJourney {
  id                String                    @id @default(uuid())
  group             String
  controlPercent    Int
  privacy           String                    @default("UNKNOWN")
  privacyAt         DateTime?
  eligibleAt        DateTime?
  suppressedAt      DateTime?
  suppressionReason String?
  createdAt         DateTime                  @default(now())
  visits            Visit[]
  pixels            RetargetingPixelAttempt[]
  privacyEvents     AdvertisingPrivacyEvent[]
}

model AdvertisingPrivacyEvent {
  id        String         @id @default(cuid())
  journeyId String
  journey   VisitorJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  choice    String
  source    String
  text      String
  createdAt DateTime       @default(now())

  @@index([journeyId, createdAt])
}

model VisitorVerification {
  id        String   @id @default(uuid())
  visitId   String
  visit     Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  state     String   @default("PENDING")
  errors    String[]
  createdAt DateTime @default(now())

  @@index([visitId, createdAt])
}

model RetargetingAudience {
  id        String                    @id
  config    Json
  revision  String
  updatedAt DateTime                  @updatedAt
  pixels    RetargetingPixelAttempt[]
}

model RetargetingPixelAttempt {
  id                String              @id @default(uuid())
  journeyId         String
  journey           VisitorJourney      @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  audienceId        String
  audience          RetargetingAudience @relation(fields: [audienceId], references: [id])
  revision          String
  // Snapshot removal configuration so later edits cannot remove the wrong audience.
  config            Json
  visitId           String
  action            String
  state             String              @default("ISSUED")
  reason            String?
  suppressionReason String?
  createdAt         DateTime            @default(now())
  reportedAt        DateTime?

  // V1 never silently retries an uncertain dispatch or reenrolls a suppressed browser.
  @@unique([journeyId, audienceId, action])
  @@index([state, createdAt])
}

model RetargetingSpend {
  campaignId String
  day        String
  amount     Decimal  @db.Decimal(12, 6)
  currency   String   @default("USD")
  reference  String
  updatedAt  DateTime @updatedAt

  @@id([campaignId, day])
}

model VisitEvent {
  id         String    @id @default(cuid())
  visitId    String
  visit      Visit     @relation(fields: [visitId], references: [id], onDelete: Cascade)
  kind       String
  questionId String    @default("")
  answer     String?
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([visitId, kind, questionId])
  @@index([kind, createdAt])
}

model AppConfiguration {
  id                    String   @id
  values                Json
  secrets               Json?
  // Retained only as a backup of credentials from installations before database storage.
  encryptedSecrets      String?
  credentialsNeedReview Boolean  @default(false)
  revision              Int      @default(1)
  updatedAt             DateTime @updatedAt
}

model Lead {
  id             String                  @id @default(uuid())
  visitId        String
  visit          Visit                   @relation(fields: [visitId], references: [id])
  name           String
  status         LeadStatus              @default(NEW)
  timezone       String                  @default("America/Chicago")
  timezoneSource String                  @default("UNKNOWN")
  answers        Json
  notes          String                  @default("")
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  lastClickedAt  DateTime?
  subscriptions  Subscription[]
  phoneConsents  PhoneMarketingConsent[]
  applications   ApplicationClick[]
  events         LeadEvent[]
}

model PhoneMarketingConsent {
  id             String   @id @default(uuid())
  leadId         String
  lead           Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  phone          String
  consentText    String
  consentVersion String
  consentAt      DateTime @default(now())
  consentIpHash  String

  @@index([phone, consentAt])
  @@index([leadId])
}

model Subscription {
  id                         String             @id @default(uuid())
  leadId                     String
  lead                       Lead               @relation(fields: [leadId], references: [id])
  channel                    Channel
  address                    String
  status                     SubscriptionStatus @default(PENDING)
  consentText                String
  consentVersion             String
  consentAt                  DateTime           @default(now())
  consentIpHash              String
  confirmedAt                DateTime?
  stoppedAt                  DateTime?
  providerListId             Int?
  verificationHash           String?
  verificationExpiresAt      DateTime?
  verificationAttempts       Int                @default(0)
  emailVerificationState     String             @default("NOT_CHECKED")
  emailVerificationCheckedAt DateTime?
  emailVerificationDiagnosis String?
  lastSentAt                 DateTime?
  enrollments                Enrollment[]
  deliveries                 Delivery[]

  @@unique([channel, address])
  @@index([leadId])
}

model Chain {
  id          String       @id @default(cuid())
  name        String
  channel     Channel
  status      RunStatus    @default(DRAFT)
  trigger     String       @default("SUBSCRIBED")
  maxDays     Int          @default(30)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  steps       ChainStep[]
  enrollments Enrollment[]
}

model ChainStep {
  id              String         @id @default(cuid())
  chainId         String
  chain           Chain          @relation(fields: [chainId], references: [id])
  position        Int
  delayHours      Int            @default(24)
  subject         String
  body            String
  offerId         String?
  offer           Offer?         @relation(fields: [offerId], references: [id], onDelete: SetNull)
  emailTemplateId String?
  emailTemplate   EmailTemplate? @relation(fields: [emailTemplateId], references: [id], onDelete: SetNull)
  mediaAssetId    String?
  mediaAsset      MessageAsset?  @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)

  @@unique([chainId, position])
}

model Enrollment {
  id             String           @id @default(cuid())
  subscriptionId String
  subscription   Subscription     @relation(fields: [subscriptionId], references: [id])
  chainId        String
  chain          Chain            @relation(fields: [chainId], references: [id])
  status         EnrollmentStatus @default(ACTIVE)
  step           Int              @default(0)
  startedAt      DateTime         @default(now())
  nextAt         DateTime         @default(now())
  deferredUntil  DateTime?
  holdReason     String?
  deliveries     Delivery[]

  @@unique([subscriptionId, chainId])
  @@index([status, nextAt])
}

model Delivery {
  id                 String             @id @default(uuid())
  subscriptionId     String
  subscription       Subscription       @relation(fields: [subscriptionId], references: [id])
  enrollmentId       String
  enrollment         Enrollment         @relation(fields: [enrollmentId], references: [id])
  step               Int
  status             DeliveryStatus     @default(PENDING)
  subject            String
  body               String
  htmlBody           String?
  providerId         String?
  error              String?
  offerId            String?
  offer              Offer?             @relation(fields: [offerId], references: [id], onDelete: SetNull)
  emailTemplateId    String?
  emailTemplate      EmailTemplate?     @relation(fields: [emailTemplateId], references: [id], onDelete: SetNull)
  mediaAssetId       String?
  mediaAsset         MessageAsset?      @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  createdAt          DateTime           @default(now())
  sentAt             DateTime?
  deliveredAt        DateTime?
  openedAt           DateTime?
  openCount          Int                @default(0)
  clickedAt          DateTime?
  clickCount         Int                @default(0)
  providerClickCount Int                @default(0)
  readAt             DateTime?
  repliedAt          DateTime?
  events             MessageEvent[]
  applications       ApplicationClick[]

  @@unique([enrollmentId, step])
  @@index([status, createdAt])
}

model ApplicationClick {
  id                    String                 @id @default(uuid())
  leadId                String?
  lead                  Lead?                  @relation(fields: [leadId], references: [id])
  visitId               String
  visit                 Visit                  @relation(fields: [visitId], references: [id])
  deliveryId            String?
  delivery              Delivery?              @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  offerId               String?
  offer                 Offer?                 @relation(fields: [offerId], references: [id], onDelete: SetNull)
  destinationUrl        String?
  createdAt             DateTime               @default(now())
  postbacks             Postback[]
  advertiserConversions AdvertiserConversion[]
}

// Durable outbound conversion feedback. Ambiguous network outcomes are held for
// review rather than retried because advertiser postbacks are not idempotent.
model AdvertiserConversion {
  id               String                        @id @default(cuid())
  visitId          String
  visit            Visit                         @relation(fields: [visitId], references: [id], onDelete: Cascade)
  applicationId    String?
  application      ApplicationClick?             @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  event            String
  goal             Int
  externalClickId  String
  payout           Decimal                       @default(0) @db.Decimal(12, 4)
  status           String                        @default("PENDING")
  attempts         Int                           @default(0)
  error            String?
  createdAt        DateTime                      @default(now())
  attemptedAt      DateTime?
  sentAt           DateTime?
  deliveryAttempts AdvertiserConversionAttempt[]

  @@unique([externalClickId, goal])
  @@index([status, createdAt])
  @@index([visitId, createdAt])
}

model AdvertiserConversionAttempt {
  id           String               @id @default(cuid())
  conversionId String
  conversion   AdvertiserConversion @relation(fields: [conversionId], references: [id], onDelete: Cascade)
  attempt      Int
  httpStatus   Int?
  outcome      String
  error        String?
  createdAt    DateTime             @default(now())
  completedAt  DateTime?

  @@unique([conversionId, attempt])
  @@index([createdAt])
}

model Postback {
  id            String           @id @default(cuid())
  eventId       String           @unique
  applicationId String
  application   ApplicationClick @relation(fields: [applicationId], references: [id])
  offerId       String?
  offer         Offer?           @relation(fields: [offerId], references: [id], onDelete: SetNull)
  event         String
  revenue       Decimal          @default(0) @db.Decimal(12, 4)
  createdAt     DateTime         @default(now())

  @@index([applicationId])
}

model Offer {
  id                String             @id @default(cuid())
  name              String
  status            RunStatus          @default(DRAFT)
  provider          String             @default("CUSTOM")
  destinationUrl    String
  trackingParameter String             @default("subId3")
  postbackKey       String             @unique
  postbackSecret    String
  isDefault         Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  experiments       Experiment[]       @relation("ExperimentOffer")
  variants          Variant[]          @relation("VariantOffer")
  chainSteps        ChainStep[]
  deliveries        Delivery[]
  applications      ApplicationClick[]
  postbacks         Postback[]

  @@index([status, isDefault])
}

model EmailTemplate {
  id          String      @id @default(cuid())
  name        String
  status      RunStatus   @default(DRAFT)
  subject     String
  preheader   String      @default("")
  eyebrow     String      @default("SPARECASH")
  headline    String
  body        String
  ctaLabel    String      @default("Explore loan options")
  accentColor String      @default("#1f5b4d")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  chainSteps  ChainStep[]
  deliveries  Delivery[]

  @@index([status, updatedAt])
}

model MessageAsset {
  id         String      @id @default(cuid())
  name       String
  fileName   String
  mimeType   String
  byteSize   Int
  data       Bytes
  createdAt  DateTime    @default(now())
  chainSteps ChainStep[]
  deliveries Delivery[]

  @@index([createdAt])
}

model MessageEvent {
  id              String   @id @default(cuid())
  deliveryId      String
  delivery        Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  type            String
  providerEventId String?
  url             String?
  detail          Json     @default("{}")
  occurredAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  @@unique([deliveryId, providerEventId, type])
  @@index([deliveryId, occurredAt])
  @@index([type, occurredAt])
}

model LeadEvent {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id])
  type      String
  detail    String
  createdAt DateTime @default(now())
}

model SourceAction {
  id        String        @id @default(cuid())
  sourceId  String
  source    TrafficSource @relation(fields: [sourceId], references: [id])
  action    String
  status    String
  evidence  Json
  error     String?
  createdAt DateTime      @default(now())
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String
  action    String
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())
}

model AdminSession {
  id        String   @id
  expiresAt DateTime
}
